
LLM_PROVIDER=mock

LLM_MODEL_NAME=google/gemma-2-2b-it

# Used by hf_local only: "cpu", "cuda", or "auto"
LLM_DEVICE=auto

# Used by anthropic only.
ANTHROPIC_API_KEY=

# --- Delta engine tuning (see src/delta/align.py, src/delta/engine.py)
DELTA_MATCH_THRESHOLD=0.5
DELTA_REVIEW_CONFIDENCE_THRESHOLD=0.55

# --- OCR (see src/ingest/pdf_scanned.py)
OCR_DPI=200
OCR_MIN_CONFIDENCE=40
